  "lessons": [
    {
      "lesson": "01-business-question-to-ml-task",
      "learning_job": "把业务愿望改写成有决策者、决策时点、可用信息、行动和失败阈值的可证伪任务。",
      "source_ids": ["book:machine-learning:probml-intro", "book:machine-learning:fairness-ml", "paper:machine-learning:hidden-technical-debt"],
      "claims_used": ["机器学习任务必须同时说明任务、经验和评价口径。", "预测只有进入行动与反馈闭环后才产生真实后果。", "模型优化不能代表整个机器学习系统已经成立。"]
    },
    {
      "lesson": "02-samples-features-labels",
      "learning_job": "在时间线上定义一条样本、特征截止点、标签观察窗与标签成熟日。",
      "source_ids": ["book:machine-learning:understanding-ml", "book:machine-learning:fairness-ml", "paper:machine-learning:datasheets"],
      "claims_used": ["训练样本是带有生成机制的观测序列，不只是表格行。", "目标变量往往是对现实构念的代理测量。", "实例含义、采样过程、收集时段和推荐切分必须被记录。"]
    },
    {
      "lesson": "03-loss-and-decision-cost",
      "learning_job": "从概率、状态和行动代价推导阈值，而不是把训练损失直接当业务价值。",
      "source_ids": ["book:machine-learning:probml-intro", "paper:machine-learning:proper-scoring-rules"],
      "claims_used": ["最优行动最小化后验期望损失。", "成本不对称会改变分类阈值，并可加入拒绝行动。", "proper scoring rule 评价的是概率报告，不替代行动成本。"]
    },
    {
      "lesson": "04-erm-generalization-baseline",
      "learning_job": "用训练/验证/测试分工、简单基线和学习曲线解释为何相信未见数据表现。",
      "source_ids": ["book:machine-learning:probml-intro", "book:machine-learning:understanding-ml", "paper:machine-learning:useful-things"],
      "claims_used": ["经验风险是可见样本上的量，总体风险才是目标。", "限制假设空间是一种归纳偏置，复杂度与样本量共同影响过拟合。", "简单不自动意味着更准，基线的作用是暴露复杂模型是否真正增益。"]
    }
  ]
