{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://007m7.github.io/learning007/schema/reading-evidence.schema.json",
  "title": "Chapter-level reading evidence",
  "type": "object",
  "required": ["field", "updated_at", "sources", "lessons"],
  "properties": {
    "field": { "type": "string" },
    "updated_at": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "official_url", "acquisition", "read_scopes"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "official_url": { "type": "string", "format": "uri" },
          "acquisition": {
            "type": "object",
            "required": ["state", "method", "artifact", "sha256"],
            "properties": {
              "state": { "enum": ["catalogued", "retrieved", "extracted", "read", "cited"] },
              "method": { "enum": ["direct_download", "tavily_extract", "official_online_read", "local_reference"] },
              "artifact": { "type": ["string", "null"] },
              "sha256": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  { "type": "null" }
                ]
              },
              "bytes": { "type": ["integer", "null"] }
            }
          },
          "read_scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["locator", "purpose"],
              "properties": {
                "locator": { "type": "string" },
                "purpose": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lesson", "learning_job", "source_ids", "claims_used"],
        "properties": {
          "lesson": { "type": "string" },
          "learning_job": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "claims_used": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    }
  }
}
