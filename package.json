{
  "name": "learning007",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "test": "npm run build",
    "lint": "vitepress build docs",
    "generate:fields": "node --experimental-strip-types scripts/generate-field-library.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "verify": "npm run check:links && npm run check:content && npm run build",
    "kb:init-books": "node scripts/knowledge-base/init-books.mjs",
    "kb:refresh": "node scripts/knowledge-base/init-books.mjs && node scripts/knowledge-base/refresh-papers.mjs",
    "kb:download-books": "node scripts/knowledge-base/download-books.mjs",
    "kb:validate": "node scripts/knowledge-base/validate.mjs",
    "kb:report": "node scripts/knowledge-base/report.mjs",
    "analyze:writing-dna": "node scripts/analyze-reference-writing-dna.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "type": "module"
}
