{
  "name": "learning007",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "test": "npm run build",
    "lint": "vitepress build docs",
    "generate:fields": "node --experimental-strip-types scripts/generate-field-library.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:sources": "node scripts/check-source-grounding.mjs",
    "verify": "npm run check:links && npm run check:content && npm run check:sources && npm run build",
    "kb:init-books": "node scripts/knowledge-base/init-books.mjs",
    "kb:refresh": "node scripts/knowledge-base/init-books.mjs && node scripts/knowledge-base/refresh-papers.mjs",
    "kb:download-books": "node scripts/knowledge-base/download-books.mjs",
    "kb:validate": "node scripts/knowledge-base/validate.mjs",
    "kb:build-ml-catalog": "node scripts/knowledge-base/build-machine-learning-catalog.mjs",
    "kb:build-model-learning-catalogs": "node scripts/knowledge-base/build-model-learning-catalogs.mjs",
    "kb:build-ai-product-catalog": "node scripts/knowledge-base/build-ai-product-catalog.mjs",
    "kb:build-ai-agent-catalog": "node scripts/knowledge-base/build-ai-agent-catalog.mjs",
    "kb:build-quality-catalog": "node scripts/knowledge-base/build-quality-catalog.mjs",
    "kb:build-quality-reviews": "node scripts/knowledge-base/build-quality-reviews.mjs",
    "kb:verify-quality-books": "node scripts/knowledge-base/verify-quality-book-urls.mjs",
    "kb:build-ai-agent-reviews": "node scripts/knowledge-base/build-ai-agent-reviews.mjs",
    "kb:verify-ai-agent-books": "node scripts/knowledge-base/verify-ai-agent-book-urls.mjs",
    "kb:build-software-catalog": "node scripts/knowledge-base/build-software-catalog.mjs",
    "kb:build-software-reviews": "node scripts/knowledge-base/build-software-reviews.mjs",
    "kb:build-software-expanded-reviews": "node scripts/knowledge-base/build-expanded-software-reviews.mjs",
    "kb:verify-software-urls": "node scripts/knowledge-base/verify-software-paper-urls.mjs",
    "kb:report": "node scripts/knowledge-base/report.mjs",
    "analyze:writing-dna": "node scripts/analyze-reference-writing-dna.mjs",
    "analyze:writing-dna:csdiy": "node scripts/analyze-csdiy-writing-dna.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "type": "module"
}
